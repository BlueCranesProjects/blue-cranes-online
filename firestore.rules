rules_version = '2';
// Blue Cranes Online
// - Each person can read and write their own time sheets, reports and inventories.
// - Admins (an "admins" document whose ID is their email, lower case) can read everyone's data
//   and load jobs for technicians.
// - The owner (the admins document with owner: true, set once by hand in Firebase) adds and removes the other admins in Admin.
//   Nobody can make another owner, and the owner's own document can't be changed from the app.
// - A technician can read the jobs loaded for their email and only update the job's progress.
// - Jobs and Admin need a confirmed email (the link sent when the account is made).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // a confirmed email (the person opened the link sent when the account was made)
    function verified() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && exists(/databases/$(database)/documents/admins/$(myEmail())); }
    function isOwner() { return isAdmin() && get(/databases/$(database)/documents/admins/$(myEmail())).data.get('owner', false) == true; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read: if isAdmin();
      match /items/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    match /admins/{email} {
      allow read: if signedIn() && request.auth.token.email != null && myEmail() == email;
      allow read: if isAdmin();
      allow create, update: if isOwner() && email != myEmail() && request.resource.data.get('owner', false) != true;
      allow delete: if isOwner() && email != myEmail();
    }

    // shared settings, e.g. settings/email: the Google script that sends the client emails
    match /settings/{id} {
      allow read: if verified();
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read, write: if isAdmin();
      allow read: if verified() && resource.data.tech == myEmail();
      allow update: if verified() && resource.data.tech == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sheetDate', 'startedAt', 'doneAt', 'updatedAt']);
    }
  }
}
